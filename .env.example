# Silver State Waste Solutions — Internal Operations Platform
# Phase 1 environment variables.
#
# NOTE: These are PLACEHOLDERS. No platform is connected in the design-skeleton
# phase. When the Supabase project is provisioned, copy this file to
# `.env.local` and fill in the real values. The mock data layer
# (src/lib/data.ts) is used until these are present.

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
