# Silver State Waste Solutions — Internal Operations Platform
# Phase 1 environment variables.
#
# Copy to `.env.local` and replace every placeholder. Missing or placeholder
# values fail validation; production never falls back to seed data.

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Set to `true` only after custom SMTP is configured in Supabase. While this is
# off the sign-in screen stops offering a self-service password reset it cannot
# deliver, and points employees at an administrator-issued temporary password
# instead. Any value other than `true` is treated as off.
NEXT_PUBLIC_EMAIL_DELIVERY_ENABLED=false

# The public address of this deployment, and the only thing that decides where
# an emailed invitation or password-reset link sends someone. Set it to the
# domain employees actually use — never a deployment-specific Vercel alias,
# which Deployment Protection answers with a Vercel login page. Falls back to
# Vercel's own production domain when unset; `/api/health` reports which of the
# two is in effect.
NEXT_PUBLIC_APP_URL=https://your-app-domain

# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# Public key is safe to expose to the browser (used by PushManager.subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-only (never expose to the browser)
SUPABASE_SECRET_KEY=your-secret-key
CRON_SECRET=replace-with-a-long-random-server-only-value

# Private half of the VAPID keypair above — signs outgoing push messages.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address push services can use if a subscription is reported as abuse.
VAPID_SUBJECT=mailto:you@your-domain

# Stripe — invoice delivery and payment. Server-only; there is no publishable
# key here on purpose, because the customer pays on Stripe's own hosted page
# and the browser never talks to Stripe directly.
#
# Use a TEST key locally (sk_test_ or a restricted rk_test_). The client
# refuses an sk_live_ key outside production: this repository syncs to iCloud,
# and a live key here can move real money. Live keys belong in the deployment
# environment and nowhere else.
STRIPE_SECRET_KEY=sk_test_your-test-key

# Signing secret for /api/webhooks/stripe. Locally this comes from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`; in a
# deployment it comes from the endpoint's own settings in the Stripe dashboard.
# The two are different values.
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret
