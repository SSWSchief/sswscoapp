# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
/coverage/
/playwright-report/
/test-results/
/imports/*
!/imports/README.md

# Local/iCloud conflict copies; canonical source files never carry a numeric
# suffix. iCloud recreates these on sync and they break knip and tsc, so the
# pattern is deliberately broad rather than per-extension.
**/* [0-9].*
**/*.* [0-9]
**/.* [0-9]
.vercel
.env*

# local editor/agent tooling
.claude/

# Business planning notes that happen to live in this checkout. They are not
# part of the client's application and a broad `git add` has swept stray files
# into a commit here before.
/whitelabelidea/
