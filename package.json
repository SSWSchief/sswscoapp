{
  "name": "sswsco-ops-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Silver State Waste Solutions — production operations platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dead-code": "knip",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:scripts && npm run dead-code && npm run build",
    "db:lint": "supabase db lint --linked --level warning",
    "import:validate": "node scripts/import-operations.mjs",
    "staging:bootstrap": "node scripts/bootstrap-staging-e2e.mjs",
    "admin:invite": "node scripts/invite-administrator.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^26.1.0",
    "knip": "^5.64.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
